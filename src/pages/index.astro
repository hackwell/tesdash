---
import { Font } from 'astro:assets';
import '../styles/dashboard.css';

const editIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>';
const plusIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>';
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Tesla</title>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<Font cssVariable="--font-geist" preload />
	</head>

	<body>
		<main>
			<section class="calendar" id="calendar" hidden aria-label="Termine heute"></section>
			<section class="home" id="home" hidden aria-label="Zuhause">
				<div class="home-status" id="home-status"></div>
				<div class="home-tiles" id="home-tiles"></div>
			</section>
			<div id="categories"></div>
			<p class="empty-state" id="empty-state" hidden>Noch keine Apps. Tippe unten rechts auf den Stift und dann auf +.</p>
		</main>

		<div class="fab-wrap">
			<button class="fab fab--hidden" id="btn-add-app" aria-label="App hinzufügen" set:html={plusIcon} />
			<button class="fab fab--secondary" id="btn-edit" aria-label="Bearbeiten" aria-pressed="false" set:html={editIcon} />
		</div>

		<!-- App form (add + edit) -->
		<div class="modal-overlay" id="modal-app" aria-hidden="true" inert>
			<div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="app-form-title">
				<button class="modal-close" data-close aria-label="Schließen">&times;</button>
				<h2 id="app-form-title" class="modal-title">App hinzufügen</h2>
				<form id="app-form" novalidate>
					<div class="form-row">
						<label class="form-label" for="app-name">Name <span class="form-required">*</span></label>
						<input class="form-input" type="text" id="app-name" maxlength="100" autocomplete="off" />
					</div>
					<div class="form-row">
						<label class="form-label" for="app-url">URL <span class="form-required">*</span></label>
						<input class="form-input" type="url" id="app-url" placeholder="https://example.com" autocomplete="off" autocorrect="off" autocapitalize="off" />
					</div>
					<div class="form-row">
						<label class="form-label" for="app-logo">Logo-URL <span class="form-optional">(optional)</span></label>
						<input class="form-input" type="url" id="app-logo" placeholder="https://example.com/logo.png" autocomplete="off" autocorrect="off" autocapitalize="off" />
					</div>
					<div class="form-row-split">
						<div class="form-row">
							<label class="form-label" for="app-category">Kategorie <span class="form-required">*</span></label>
							<select class="form-input form-select" id="app-category"></select>
						</div>
						<div class="form-row">
							<label class="form-label" for="app-color">Farbe</label>
							<input class="form-color" type="color" id="app-color" value="#e50914" />
						</div>
					</div>
					<div class="form-row" id="new-cat-row" hidden>
						<label class="form-label" for="app-new-cat">Neue Kategorie <span class="form-required">*</span></label>
						<input class="form-input" type="text" id="app-new-cat" maxlength="100" autocomplete="off" />
					</div>
					<div class="form-row form-row--inline">
						<input type="checkbox" id="app-auto-color" checked />
						<label class="form-label" for="app-auto-color">Farbe aus dem Logo übernehmen</label>
					</div>
					<div class="form-row form-row--toggle">
						<label class="form-label">Vollbild</label>
						<label class="toggle-switch">
							<input type="checkbox" id="app-fullscreen" checked />
							<span class="toggle-track"><span class="toggle-thumb"></span></span>
							<span class="toggle-hint">Öffnet über den YouTube-Umweg im Vollbild</span>
						</label>
					</div>
					<p class="form-error" id="form-error" hidden></p>
					<div class="form-actions">
						<button type="button" class="form-btn form-btn-danger" id="app-delete" hidden>Löschen</button>
						<button type="button" class="form-btn form-btn-cancel" data-close>Abbrechen</button>
						<button type="submit" class="form-btn form-btn-submit" id="app-submit">Hinzufügen</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Category form (rename + delete) -->
		<div class="modal-overlay" id="modal-category" aria-hidden="true" inert>
			<div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="cat-form-title">
				<button class="modal-close" data-close aria-label="Schließen">&times;</button>
				<h2 id="cat-form-title" class="modal-title">Kategorie</h2>
				<form id="cat-form" novalidate>
					<div class="form-row">
						<label class="form-label" for="cat-name">Name <span class="form-required">*</span></label>
						<input class="form-input" type="text" id="cat-name" maxlength="100" autocomplete="off" />
					</div>
					<p class="form-error" id="cat-error" hidden></p>
					<div class="form-actions">
						<button type="button" class="form-btn form-btn-danger" id="cat-delete">Löschen</button>
						<button type="button" class="form-btn form-btn-cancel" data-close>Abbrechen</button>
						<button type="submit" class="form-btn form-btn-submit">Speichern</button>
					</div>
				</form>
			</div>
		</div>

		<div class="toast" id="toast" role="status" aria-live="polite"></div>

		<script>
			import { initDashboard } from '../lib/dashboard';
			import { initCalendarBar } from '../lib/calendar-bar';
			import { initHomeBar } from '../lib/home-bar';
			initCalendarBar();
			initHomeBar();
			initDashboard();
		</script>
	</body>
</html>
